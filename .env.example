# Токен бота от @BotFather
BOT_TOKEN=

# Прокси для Telegram, если api.telegram.org недоступен напрямую: socks5://host:port или http://host:port.
# Логин и пароль — если прокси с авторизацией.
TG_PROXY=
TG_PROXY_LOGIN=
TG_PROXY_PASSWORD=

# OwenCloud API (менять не нужно). Прокси к нему обычно не нужен; если нужен —
# OWEN_PROXY, OWEN_PROXY_LOGIN, OWEN_PROXY_PASSWORD по аналогии с TG_PROXY.
OWEN_API_URL=https://api.owencloud.ru/v1

# Интервал опроса журналов событий OwenCloud, секунды
POLL_INTERVAL=60

# Ключ шифрования API-ключей OwenCloud в БД. Сгенерировать:
#   docker run --rm whitemanprk/owen_bot python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# При потере ключа пользователям придётся заново добавить ключи OwenCloud.
ENCRYPTION_KEY=

# Код доступа. Пусто — ботом может пользоваться любой.
# Задан — бот попросит ввести код в каждом новом чате. При смене кода всем чатам
# придётся ввести новый, до этого уведомления в них не отправляются.
ACCESS_CODE=

# PostgreSQL (контейнер db, наружу не публикуется)
POSTGRES_DB=owenbot
POSTGRES_USER=owenbot
POSTGRES_PASSWORD=

# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
